       IDENTIFICATION DIVISION.
       CLASS-ID. ACCOUNT.
      * A bank account class with a savings subclass.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS ACCOUNT AS "Account".
       OBJECT.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 BALANCE        PIC S9(7)V99 VALUE ZERO.
       PROCEDURE DIVISION.
       METHOD-ID. DEPOSIT.
       DATA DIVISION.
       LINKAGE SECTION.
       01 AMT            PIC 9(7)V99.
       PROCEDURE DIVISION USING AMT.
           ADD AMT TO BALANCE.
       END METHOD DEPOSIT.
       METHOD-ID. WITHDRAW.
       DATA DIVISION.
       LINKAGE SECTION.
       01 AMT            PIC 9(7)V99.
       01 OK-FLAG        PIC X.
       PROCEDURE DIVISION USING AMT RETURNING OK-FLAG.
           IF AMT > BALANCE
               MOVE "N" TO OK-FLAG
           ELSE
               SUBTRACT AMT FROM BALANCE
               MOVE "Y" TO OK-FLAG
           END-IF.
       END METHOD WITHDRAW.
       METHOD-ID. GET-BALANCE.
       DATA DIVISION.
       LINKAGE SECTION.
       01 OUT-BAL        PIC S9(7)V99.
       PROCEDURE DIVISION RETURNING OUT-BAL.
           MOVE BALANCE TO OUT-BAL.
       END METHOD GET-BALANCE.
       END OBJECT.
       END CLASS ACCOUNT.

       IDENTIFICATION DIVISION.
       CLASS-ID. SAVINGS INHERITS ACCOUNT.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS ACCOUNT AS "Account"
           CLASS SAVINGS AS "Savings".
       OBJECT.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 RATE           PIC 9V99 VALUE 0.05.
       PROCEDURE DIVISION.
       METHOD-ID. ADD-INTEREST.
       DATA DIVISION.
       LOCAL-STORAGE SECTION.
       01 CURRENT-BAL    PIC S9(7)V99.
       01 INTEREST       PIC 9(7)V99.
       PROCEDURE DIVISION.
           INVOKE SELF "GET-BALANCE" RETURNING CURRENT-BAL.
           COMPUTE INTEREST ROUNDED = CURRENT-BAL * RATE.
           INVOKE SELF "DEPOSIT" USING INTEREST.
       END METHOD ADD-INTEREST.
       END OBJECT.
       END CLASS SAVINGS.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. BANK.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS ACCOUNT AS "Account"
           CLASS SAVINGS AS "Savings".
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 ACC            USAGE OBJECT REFERENCE ACCOUNT.
       01 SAV            USAGE OBJECT REFERENCE SAVINGS.
       01 AMOUNT         PIC 9(7)V99.
       01 OK-FLAG        PIC X.
       01 BAL            PIC S9(7)V99.
       01 SHOWN          PIC -Z,ZZZ,ZZ9.99.
       PROCEDURE DIVISION.
           INVOKE ACCOUNT "NEW" RETURNING ACC.
           MOVE 500.00 TO AMOUNT.
           INVOKE ACC "DEPOSIT" USING AMOUNT.
           MOVE 800.00 TO AMOUNT.
           INVOKE ACC "WITHDRAW" USING AMOUNT RETURNING OK-FLAG.
           DISPLAY "withdraw 800: " OK-FLAG.
           MOVE 120.50 TO AMOUNT.
           INVOKE ACC "WITHDRAW" USING AMOUNT RETURNING OK-FLAG.
           DISPLAY "withdraw 120.50: " OK-FLAG.
           INVOKE ACC "GET-BALANCE" RETURNING BAL.
           MOVE BAL TO SHOWN.
           DISPLAY "balance " SHOWN.
           INVOKE SAVINGS "NEW" RETURNING SAV.
           MOVE 1000.00 TO AMOUNT.
           INVOKE SAV "DEPOSIT" USING AMOUNT.
           INVOKE SAV "ADD-INTEREST".
           INVOKE SAV "GET-BALANCE" RETURNING BAL.
           MOVE BAL TO SHOWN.
           DISPLAY "savings " SHOWN.
           INVOKE ACC "FREE".
           INVOKE SAV "FREE".
           STOP RUN.
