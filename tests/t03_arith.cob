       IDENTIFICATION DIVISION.
       PROGRAM-ID. ARITH.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       77 A PIC S9(5)V99 VALUE 100.50.
       77 B PIC S9(5)V99 VALUE 20.25.
       77 C PIC S9(5)V99.
       77 D PIC 9(3).
       77 E PIC 9(2)V9.
       77 Q PIC 9(4).
       77 R PIC 9(4).
       77 BIG PIC 9(18) VALUE 999999999999999999.
       77 BIG2 PIC 9(18).
       77 F1 COMP-2.
       PROCEDURE DIVISION.
           ADD A B GIVING C. DISPLAY "ADD " C.
           ADD 1 TO C. DISPLAY "ADD1 " C.
           SUBTRACT B FROM A GIVING C. DISPLAY "SUB " C.
           SUBTRACT 5 10 FROM C. DISPLAY "SUB2 " C.
           MULTIPLY A BY B GIVING C. DISPLAY "MUL " C.
           MULTIPLY 2 BY B. DISPLAY "MUL2 " B.
           DIVIDE A BY 3 GIVING C. DISPLAY "DIV " C.
           DIVIDE A BY 3 GIVING C ROUNDED. DISPLAY "DIVR " C.
           DIVIDE 7 INTO 100 GIVING Q REMAINDER R.
           DISPLAY "Q=" Q " R=" R.
           COMPUTE C = (A + B) * 2 - 10 / 4.
           DISPLAY "COMP " C.
           COMPUTE C ROUNDED = 10 / 3. DISPLAY "C3 " C.
           COMPUTE C = 2 ** 10. DISPLAY "POW " C.
           COMPUTE D = 1000.
           DISPLAY "TRUNC " D.
           COMPUTE D = 1000 ON SIZE ERROR DISPLAY "OVERFLOW"
               NOT ON SIZE ERROR DISPLAY "OK" END-COMPUTE.
           MOVE 5 TO D.
           ADD 999 TO D ON SIZE ERROR DISPLAY "SIZE ERR " D.
           COMPUTE E = 3.14159. DISPLAY "E=" E.
           COMPUTE E ROUNDED = 3.14159. DISPLAY "ER=" E.
           COMPUTE BIG2 = BIG + 0. DISPLAY "BIG " BIG2.
           COMPUTE BIG2 = BIG / 3. DISPLAY "BIG3 " BIG2.
           DIVIDE 0 INTO 5 GIVING Q ON SIZE ERROR
               DISPLAY "DIV BY ZERO".
           COMPUTE C = -A + B. DISPLAY "NEG " C.
           COMPUTE C = FUNCTION MAX(A, B) + FUNCTION MIN(A, B).
           DISPLAY "MAXMIN " C.
           COMPUTE C = FUNCTION MOD(17, 5). DISPLAY "MOD " C.
           COMPUTE C = FUNCTION SQRT(144). DISPLAY "SQRT " C.
           COMPUTE C = FUNCTION INTEGER(-2.5). DISPLAY "INT " C.
           COMPUTE C = FUNCTION ABS(-7.25). DISPLAY "ABS " C.
           STOP RUN.
