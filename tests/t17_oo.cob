       IDENTIFICATION DIVISION.
       CLASS-ID. COUNTER.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS COUNTER AS "Counter".
       FACTORY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 CREATED PIC 99 VALUE 0.
       PROCEDURE DIVISION.
       METHOD-ID. NEW.
       DATA DIVISION.
       LINKAGE SECTION.
       01 R USAGE OBJECT REFERENCE.
       PROCEDURE DIVISION RETURNING R.
           INVOKE SUPER "NEW" RETURNING R.
           ADD 1 TO CREATED.
           INVOKE R "RESET".
       END METHOD NEW.
       METHOD-ID. HOWMANY.
       DATA DIVISION.
       LINKAGE SECTION.
       01 N PIC 99.
       PROCEDURE DIVISION RETURNING N.
           MOVE CREATED TO N.
       END METHOD HOWMANY.
       END FACTORY.
       OBJECT.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 VAL PIC 9(4) VALUE 100.
       PROCEDURE DIVISION.
       METHOD-ID. RESET.
       PROCEDURE DIVISION.
           MOVE 0 TO VAL.
       END METHOD RESET.
       METHOD-ID. INCR.
       DATA DIVISION.
       LINKAGE SECTION.
       01 BY-N PIC 9(4).
       PROCEDURE DIVISION USING BY-N.
           ADD BY-N TO VAL.
       END METHOD INCR.
       METHOD-ID. GET-VALUE.
       DATA DIVISION.
       LINKAGE SECTION.
       01 OUT-V PIC 9(4).
       PROCEDURE DIVISION RETURNING OUT-V.
           MOVE VAL TO OUT-V.
       END METHOD GET-VALUE.
       END OBJECT.
       END CLASS COUNTER.

       IDENTIFICATION DIVISION.
       CLASS-ID. STEPCOUNTER INHERITS COUNTER.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS COUNTER AS "Counter"
           CLASS STEPCOUNTER AS "StepCounter".
       OBJECT.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 STEP-V PIC 99 VALUE 5.
       PROCEDURE DIVISION.
       METHOD-ID. INCR OVERRIDE.
       DATA DIVISION.
       LINKAGE SECTION.
       01 BY-N PIC 9(4).
       PROCEDURE DIVISION USING BY-N.
           MULTIPLY STEP-V BY BY-N.
           INVOKE SUPER "INCR" USING BY-N.
       END METHOD INCR.
       END OBJECT.
       END CLASS STEPCOUNTER.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. OOTEST.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       REPOSITORY.
           CLASS COUNTER AS "Counter"
           CLASS STEPCOUNTER AS "StepCounter".
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 C1 USAGE OBJECT REFERENCE COUNTER.
       01 C2 USAGE OBJECT REFERENCE.
       01 S1 USAGE OBJECT REFERENCE.
       01 V PIC 9(4).
       01 HOW PIC 99.
       01 K3 PIC 9(4) VALUE 3.
       01 K4 PIC 9(4) VALUE 4.
       PROCEDURE DIVISION.
           INVOKE COUNTER "NEW" RETURNING C1.
           INVOKE COUNTER "NEW" RETURNING C2.
           INVOKE C1 "INCR" USING K3.
           INVOKE C2 "INCR" USING K4.
           INVOKE C1 "INCR" USING K4.
           INVOKE C1 "GET-VALUE" RETURNING V.
           DISPLAY "C1=" V.
           INVOKE C2 "GET-VALUE" RETURNING V.
           DISPLAY "C2=" V.
           INVOKE COUNTER "HOWMANY" RETURNING HOW.
           DISPLAY "created " HOW.
           INVOKE STEPCOUNTER "NEW" RETURNING S1.
           INVOKE S1 "INCR" USING K3.
           INVOKE S1 "GET-VALUE" RETURNING V.
           DISPLAY "S1=" V.
           INVOKE COUNTER "HOWMANY" RETURNING HOW.
           DISPLAY "created " HOW.
           INVOKE C1 "NOSUCH" ON EXCEPTION DISPLAY "no method".
           SET C2 TO NULL.
           IF C2 = NULL DISPLAY "null ref".
           STOP RUN.
